# Copy to .env for local development. Vite only exposes variables prefixed
# with VITE_ to the browser.

# The HR Assistant chat service (chatbot-backend). Defaults to
# http://localhost:8000 when unset, which is what run_server.bat starts.
VITE_CHATBOT_API_URL=http://localhost:8000

# Shift roster application, opened from the attendance screens.
VITE_SHIFT_URL=http://localhost:54776/ShiftRoster/
