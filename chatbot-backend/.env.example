# ============================================================================
# ISMO HR Assistant - configuration
# Copy to .env and adjust per environment. Everything here has a default that
# matches the development setup, except DJANGO_SECRET_KEY, which must match the
# dashboard exactly.
# ============================================================================

# --- identity -----------------------------------------------------------
# MUST be byte-identical to SECRET_KEY in backend/hris/settings.py. The login
# token is signed with it; if they differ, every request is rejected as 401.
DJANGO_SECRET_KEY=django-insecure-4&quhz))qhg9a(t#^fmycf=bf=dn#5n$k1k2d61)u+d&=ro8e#
JWT_LEEWAY_SECONDS=60

# --- database -----------------------------------------------------------
# The same SQL Server database the dashboard uses. HR data is read from it, and
# the chatbot's own tables (conversations, messages, documents) are created in
# it on first start.
#   development / production : Attendance_System
#   staging                  : Attendance_Stage
DB_HOST=192.168.157.51
DB_PORT=9090
DB_NAME=Attendance_System
DB_USER=sa
DB_PASSWORD=Sa@157
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# --- models (Ollama, running locally) -----------------------------------
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=mistral:latest
EMBEDDING_MODEL=nomic-embed-text
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=700

# --- retrieval ----------------------------------------------------------
RETRIEVAL_TOP_K=6
# Cosine distance ceiling. Measured on the HR manual: a real match lands
# around 0.20-0.37, an unrelated question 0.45+. Raise it and the assistant
# starts answering from passages that merely look similar.
RETRIEVAL_MAX_DISTANCE=0.45

# --- storage ------------------------------------------------------------
CHROMA_PATH=./chroma_db
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE_MB=25

# --- reports ------------------------------------------------------------
REPORT_MAX_ROWS=5000
REPORT_MAX_RANGE_DAYS=800

# --- http ---------------------------------------------------------------
# Where the dashboard is served from. A browser origin that is not listed here
# cannot call this service.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://192.168.157.55:9000,http://192.168.157.55:9002

# Set to true to log every SQL statement. Verbose; for debugging only.
DEBUG_SQL=false
